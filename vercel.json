{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "*.js",
          "*.xml",
          "*.txt",
          "*.webmanifest",
          "css/**",
          "js/**",
          "images/**",
          "data/**",
          "templates/**",
          "routes/**",
          "api/**",
          "services/**",
          "middleware/**",
          "config/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
